# ─── GIREAPP Frontend Environment Variables ───

# The URL of the backend API
NEXT_PUBLIC_API_URL="http://localhost:8000"


# The same secret used in the backend for JWT validation
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Sent to the backend with each learner's IP so its rate limits apply per
# learner. Must equal the backend's CLIENT_IP_SECRET. Never prefix it with
# NEXT_PUBLIC_ — it must stay on the server.
CLIENT_IP_SECRET="generate-with: openssl rand -base64 32"

# Origin of the object-storage bucket. Photos and lesson files upload straight
# from the browser to storage; unset, the security policy silently blocks them.
NEXT_PUBLIC_MEDIA_URL=""

# The site's own public URL, used for link previews. Set it in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
